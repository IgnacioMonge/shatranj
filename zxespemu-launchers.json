{
  "schema": 2,
  "owner": "netchess",
  "version": "1.3.0",
  "launchers": [
    {
      "name": "Shatranj Classic",
      "bundle_id": "com.ignaciomongegarcia.netchesszx.zx",
      "arguments": [
        "--program",
        "netchess",
        "--target",
        "classic",
        "--netchess",
        "."
      ],
      "icon": "client/shatranj.icns"
    },
    {
      "name": "Shatranj Next",
      "bundle_id": "com.ignaciomongegarcia.netchesszx.next",
      "arguments": [
        "--program",
        "netchess",
        "--target",
        "next",
        "--netchess",
        "."
      ],
      "icon": "client/shatranj.icns"
    },
    {
      "name": "Shatranj SpectraNext",
      "bundle_id": "com.ignaciomongegarcia.netchesszx.spectranext",
      "runtime": "fusex",
      "arguments": [
        "--program",
        "spectranext",
        "--spectranext-manifest",
        "./packaging/spectranext/port.json"
      ],
      "icon": "client/shatranj.icns"
    }
  ]
}
